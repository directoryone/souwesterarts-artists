{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "regions": [
    "pdx1"
  ],
  "crons": [
    {
      "path": "/api/cron/draft-reminder",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/upsell-reminders",
      "schedule": "0 15 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/categories/visual",
      "destination": "/categories/visual-arts",
      "permanent": true
    },
    {
      "source": "/best-visual-in/:path*",
      "destination": "/best-visual-arts-in/:path*",
      "permanent": true
    },
    {
      "source": "/categories/literature",
      "destination": "/categories/literary-arts",
      "permanent": true
    },
    {
      "source": "/best-literature-in/:path*",
      "destination": "/best-literary-arts-in/:path*",
      "permanent": true
    },
    {
